<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("partials/head") %>
</head>
<body>
    <%- include("partials/nav") %>
    <div class="container mt-3">
        <h1><%= blog.title %></h1>
        <img src="<%= blog.coverImageURL %>" alt="Blog" class="w-25 h-25">
        <pre class="mt-3"><%= blog.body %></pre>
        <div class="d-flex mt-3 align-items-center ">
            <img src="<%= blog.createdBy.profileImageURL %>" alt="" style="width: 50px;">
            <h4 class="align-middle text-center"><%= blog.createdBy.name %></h4>
        </div>
        <h3 class="mt-3">Comments(<%= comments.length %>)</h3>
        <% if (locals.user) { %>
            <div class="mt-2">
                <form action="/blog/comment/<%= blog._id %>" method="POST">
                    <input type="text" name="content" id="content" placeholder="Write comment..." class="form-control">
                    <button type="submit" class="btn btn-sm btn-success m-1">Add</button>
                </form>
            </div>
        <% } %>
        <div class="mt-2">
            <% comments.forEach( comment => { %>
                <div class="bg-success bg-opacity-10 px-3 pt-3 pb-1 rounded-2 mt-2">
                    <img src="<%= comment.commentedBy.profileImageURL %>" alt="" style="width: 25px;">
                    <h6 class="align-middle"><%= comment.commentedBy.name %></h6>
                    <p><%= comment.content %></p>
                </div>
            <% }) %>
        </div>
    </div>
    
  </div>
    <%- include('partials/scripts') %>
</body>
</html>